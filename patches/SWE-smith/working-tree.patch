+def _replace_integer_value(original: libcst.Integer, value: int):
+    """Build a valid CST expression for an integer, including negative values."""
+    if value >= 0:
+        return original.with_changes(value=str(value))
+    return libcst.UnaryOperation(
+        operator=libcst.Minus(),
+        expression=original.with_changes(value=str(abs(value))),
+    )
+
