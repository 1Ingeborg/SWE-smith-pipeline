@@ -125,3 +125,23 @@ def test_operation_change_constants(src, expected_variants):
     assert any(result.strip() == variant.strip() for variant in expected_variants), (
         f"Got: {result!r}, expected one of: {expected_variants!r}"
     )
+
+
+def test_operation_change_constants_constructs_valid_negative_integer():
+    class AlwaysDecrement:
+        @staticmethod
+        def random():
+            return 0.0
+
+        @staticmethod
+        def choice(_choices):
+            return -1
+
+    module = libcst.parse_module("def foo(x):\n    return x + 0\n")
+    modifier = OperationChangeConstantsModifier(likelihood=1.0, seed=42)
+    modifier.rand = AlwaysDecrement()
+
+    modified = module.visit(modifier.Transformer(modifier))
+
+    assert "x + -1" in modified.code
+    libcst.parse_module(modified.code)
